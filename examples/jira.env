# Copy to ~/.claude/jira.env (shared) or <repo>/.claude/jira.env (per repo). Never commit.
JIRA_BASE_URL=https://jira.girnarsoft.com
JIRA_USER=you@girnarsoft.com
JIRA_PASS=your-jira-password-or-api-token
# or a bearer token instead of user/pass:
# JIRA_TOKEN=...
BITBUCKET_EMAIL=you@girnarsoft.com
BITBUCKET_API_TOKEN=your-bitbucket-api-token
# or: BITBUCKET_ACCESS_TOKEN=...
