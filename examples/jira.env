# Copy to ~/.claude/jira.env (shared) or <repo>/.claude/jira.env (per repo). Never commit.
JIRA_BASE_URL=https://jira.example.com
# Jira Server / Data Center:
JIRA_USER=you@example.com
JIRA_PASS=your-password-or-personal-access-token
# or a bearer PAT:            JIRA_TOKEN=...
# or Jira Cloud:              JIRA_EMAIL=you@example.com  JIRA_API_TOKEN=...

# Git host -- only the one your repositories use:
BITBUCKET_EMAIL=you@example.com
BITBUCKET_API_TOKEN=your-bitbucket-api-token
# or: BITBUCKET_ACCESS_TOKEN=...
# GitHub: GITHUB_TOKEN=ghp_...   (repo scope: read PRs, write issue comments)
